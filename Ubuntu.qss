/*
Ubuntu Style Sheet for QT Applications
Author: Jaime A. Quiroga P.
Company: GTRONICK
Last updated: 25/08/2026 12:37:20
Available at: https://github.com/GTRONICK/QSS/blob/master/Ubuntu.qss
*/


QMainWindow {
	background-color:#f0f0f0;
}

QCheckBox {
	padding:2px;
}

QCheckBox:hover {
	border:1px solid #ff963c;
	border-radius:4px;
	padding: 1px;
	background-color:qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(190, 90, 50, 50), stop:1 rgba(250, 130, 40, 50));
}

QCheckBox::indicator:checked {
	border:1px solid #f68656;
	border-radius:4px;
	background-color:#f68656;
}

QCheckBox::indicator:unchecked {
	border-width:1px solid #f68656;
	border-radius:4px;
	background-color:#ffffff;
}

QColorDialog {
	background-color:#f0f0f0;
}

QComboBox {
	color:#514841;
	background: #ffffff;
}

QComboBox QAbstractItemView {
	selection-color: #ffffff;
	selection-background-color: #f68656;
}

QComboBox:editable {
	selection-color:#514841;
	selection-background-color: #ffffff;
}

QComboBox:!editable:on,
QComboBox::drop-down:editable:on {
	color:  #1e1d23;
}

QDateEdit,
QDateTimeEdit,
QDoubleSpinBox,
QFontComboBox {
	color:#514841;
	background-color: #ffffff;
}

QDialog {
	background-color:#f0f0f0;
}

QLabel,
QLineEdit {
	color:#111111;
}

QLineEdit {
	background-color:#ffffff;
	selection-background-color:#ec7440;
}

QMenuBar {
	color:#dfdbd2;
	background-color:#41403b;
}

QMenuBar::item {
	padding-top:4px;
	padding-left:4px;
	padding-right:4px;
	color:#dfdbd2;
	background-color:#41403b;
}

QMenuBar::item:selected {
	color:#ffffff;
	padding-top:2px;
	padding-left:2px;
	padding-right:2px;
	border-top-width:2px;
	border-left-width:2px;
	border-right-width:2px;
	border-top-right-radius:4px;
	border-top-left-radius:4px;
	border-style:solid;
	background-color:#41403b;
	border-top-color: #2f2f2c;
	border-right-color: qlineargradient(spread:pad, x1:0, y1:1, x2:1, y2:0, stop:0 rgba(90, 87, 78, 255), stop:1 rgba(47,47,44, 255));
	border-left-color:  qlineargradient(spread:pad, x1:1, y1:0, x2:0, y2:0, stop:0 rgba(90, 87, 78, 255), stop:1 rgba(47,47,44, 255));
}

QMenu {
	color:#dfdbd2;
	background-color:#41403b;
}

QMenu::item {
	color:#dfdbd2;
	padding:4px 10px 4px 20px;
}

QMenu::item:selected {
	color:#ffffff;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(225, 108, 54, 255), stop:1 rgba(246, 134, 86, 255));
	border-style:solid;
	border-width:3px;
	padding:4px 7px 4px 17px;
	border-bottom-color:qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(175,85,48,255), stop:1 rgba(236,114,67, 255));
	border-top-color:qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(253,156,113,255), stop:1 rgba(205,90,46, 255));
	border-right-color:qlineargradient(spread:pad, x1:0, y1:0.5, x2:1, y2:0.5, stop:0 rgba(253,156,113,255), stop:1 rgba(205,90,46, 255));
	border-left-color:qlineargradient(spread:pad, x1:1, y1:0.5, x2:0, y2:0.5, stop:0 rgba(253,156,113,255), stop:1 rgba(205,90,46, 255));
}

QPlainTextEdit {
	border: 1px solid transparent;
	color:#111111;
	selection-background-color:#ec7440;
	background-color: #FFFFFF;
}

QProgressBar {
	text-align: center;
	color: #000000;
	border: 1px inset #969696;
	border-radius: 10px;
	background-color:#dddddb;
}

QProgressBar::chunk:horizontal {
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(225, 108, 54, 255), stop:1 rgba(246, 134, 86, 255));
	border:1px solid;
	border-radius:8px;
	border-bottom-color:qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(175,85,48,255), stop:1 rgba(236,114,67, 255));
	border-top-color:qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(253,156,113,255), stop:1 rgba(205,90,46, 255));
	border-right-color:qlineargradient(spread:pad, x1:0, y1:0.5, x2:1, y2:0.5, stop:0 rgba(253,156,113,255), stop:1 rgba(205,90,46, 255));
	border-left-color:qlineargradient(spread:pad, x1:1, y1:0.5, x2:0, y2:0.5, stop:0 rgba(253,156,113,255), stop:1 rgba(205,90,46, 255));
}

QPushButton {
	color:#111111;
	border-width: 1px;
	border-radius: 6px;
	border-bottom-color: #969696;
	border-right-color: #a5a5a5;
	border-left-color: #a5a5a5;
	border-top-color: #b4b4b4;
	border-style: solid;
	padding: 4px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(255, 255, 255, 255));
}

QPushButton:hover {
	color:#111111;
	border-width: 1px;
	border-radius:6px;
	border-top-color: #ff963c;
	border-right-color: qlineargradient(spread:pad, x1:0, y1:1, x2:1, y2:0, stop:0 rgba(200, 70, 20, 255), stop:1 rgba(255,150,60, 255));
	border-left-color:  qlineargradient(spread:pad, x1:1, y1:0, x2:0, y2:0, stop:0 rgba(200, 70, 20, 255), stop:1 rgba(255,150,60, 255));
	border-bottom-color: #c84614;
	border-style: solid;
	padding: 2px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(255, 255, 255, 255));
}

QPushButton:default {
	color:#111111;
	border-width: 1px;
	border-radius:6px;
	border-top-color: #ff963c;
	border-right-color: qlineargradient(spread:pad, x1:0, y1:1, x2:1, y2:0, stop:0 rgba(200, 70, 20, 255), stop:1 rgba(255,150,60, 255));
	border-left-color:  qlineargradient(spread:pad, x1:1, y1:0, x2:0, y2:0, stop:0 rgba(200, 70, 20, 255), stop:1 rgba(255,150,60, 255));
	border-bottom-color: #c84614;
	border-style: solid;
	padding: 2px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(255, 255, 255, 255));
}

QPushButton:pressed {
	color:#111111;
	border-radius: 6px;
	border-width: 1px;
	border-top-color: rgba(255,150,60,200);
	border-right-color: qlineargradient(spread:pad, x1:0, y1:1, x2:1, y2:0, stop:0 rgba(200, 70, 20, 255), stop:1 rgba(255,150,60, 200));
	border-left-color:  qlineargradient(spread:pad, x1:1, y1:0, x2:0, y2:0, stop:0 rgba(200, 70, 20, 255), stop:1 rgba(255,150,60, 200));
	border-bottom-color: rgba(200,70,20,200);
	border-style: solid;
	padding: 2px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:0, x2:0.5, y2:1, stop:0 rgba(220, 220, 220, 255), stop:1 rgba(255, 255, 255, 255));
}

QPushButton:disabled {
	color:#aea79f;
	border-width: 1px;
	border-radius: 6px;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(200, 200, 200, 255), stop:1 rgba(230, 230, 230, 255));
}

QRadioButton {
	padding: 1px;
}

QRadioButton::indicator:checked {
	height: 10px;
	width: 10px;
	border-style:solid;
	border-radius:5px;
	border-width: 1px;
	border-color: rgba(246, 134, 86, 255);
	color: #a9b7c6;
	background-color:rgba(246, 134, 86, 255);
}

QRadioButton::indicator:!checked {
	height: 10px;
	width: 10px;
	border-style:solid;
	border-radius:5px;
	border-width: 1px;
	border-color: #f68656;
	color: #a9b7c6;
	background-color: transparent;
}

QScrollArea {
	color: white;
	background-color:#f0f0f0;
}

QSlider::groove {
	border-style: solid;
	border-width: 1px;
	border-color: #cfcfcf;
}

QSlider::groove:horizontal {
	height: 5px;
	background: #f68656;
}

QSlider::groove:vertical {
	width: 5px;
	background: #f68656;
}

QSlider::handle:horizontal {
	background: #fdfdfd;
	border-style: solid;
	border-width: 1px;
	border-color: #cfcfcf;
	width: 12px;
	margin: -5px 0;
	border-radius: 7px;
}

QSlider::handle:vertical {
	background: #fdfdfd;
	border-style: solid;
	border-width: 1px;
	border-color: #cfcfcf;
	height: 12px;
	margin: 0 -5px;
	border-radius: 7px;
}

QSlider::add-page:horizontal,
QSlider::add-page:vertical {
	background: white;
}

QSlider::sub-page:horizontal,
QSlider::sub-page:vertical {
	background: #f68656;
}

QSpinBox,
QStatusBar {
	color:#514841;
}

QSpinBox {
	background-color: #ffffff;
}

QScrollBar:horizontal {
	max-height: 20px;
	border: 1px transparent;
	margin: 0px 20px 0px 20px;
}

QScrollBar:vertical {
	max-width: 20px;
	border: 1px transparent grey;
	margin: 20px 0px 20px 0px;
}

QScrollBar::handle:horizontal {
	background: #fdfdfd;
	border: 1px solid #cfcfcf;
	border-radius: 7px;
	min-width: 25px;
}

QScrollBar::add-line:horizontal {
	border: 1px solid #cfcfcf;
	border-top-right-radius: 7px;
	border-top-left-radius: 7px;
	border-bottom-right-radius: 7px;
	background: #ffffff;
	width: 20px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal {
	border: 1px solid #cfcfcf;
	border-top-right-radius: 7px;
	border-top-left-radius: 7px;
	border-bottom-left-radius: 7px;
	background: #ffffff;
	width: 20px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::left-arrow:horizontal {
	border: 1px transparent grey;
	border-top-left-radius: 3px;
	border-bottom-left-radius: 3px;
	width: 6px;
	height: 6px;
	background: #e6e6e6;
}

QScrollBar::right-arrow:horizontal {
	border: 1px transparent grey;
	border-top-right-radius: 3px;
	border-bottom-right-radius: 3px;
	width: 6px;
	height: 6px;
	background: #e6e6e6;
}

QScrollBar::add-line:vertical {
	border: 1px solid;
	border-color: #cfcfcf;
	border-bottom-right-radius: 7px;
	border-bottom-left-radius: 7px;
	border-top-left-radius: 7px;
	background: #ffffff;
	height: 20px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical {
	border: 1px solid #cfcfcf;
	border-top-right-radius: 7px;
	border-top-left-radius: 7px;
	border-bottom-left-radius: 7px;
	background: #ffffff;
	height: 20px;
	subcontrol-position: top;
	subcontrol-origin: margin;
}

QScrollBar::handle:vertical {
	background: #fdfdfd;
	border: 1px solid #cfcfcf;
	border-radius: 7px;
	min-height: 25px;
}

QScrollBar::up-arrow:vertical {
	border: 1px transparent grey;
	border-top-left-radius: 3px;
	border-top-right-radius: 3px;
	width: 6px;
	height: 6px;
	background: #e6e6e6;
}

QScrollBar::down-arrow:vertical {
	border: 1px transparent grey;
	border-bottom-left-radius: 3px;
	border-bottom-right-radius: 3px;
	width: 6px;
	height: 6px;
	background: #e6e6e6;
}

QScrollBar::handle:horizontal:hover {
	background: #fdfdfd;
	border: 1px solid #ff963c;
	border-radius: 7px;
	min-width: 25px;
}

QScrollBar::add-line:horizontal:hover {
	border: 1px solid #ff963c;
	border-top-right-radius: 7px;
	border-top-left-radius: 7px;
	border-bottom-right-radius: 7px;
	background: #ffffff;
	width: 20px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:pressed {
	border: 1px solid grey;
	border-top-left-radius: 7px;
	border-top-right-radius: 7px;
	border-bottom-right-radius: 7px;
	background: #e7e7e7;
	width: 20px;
	subcontrol-position: right;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal:hover {
	border: 1px solid #ff963c;
	border-top-right-radius: 7px;
	border-top-left-radius: 7px;
	border-bottom-left-radius: 7px;
	background: #ffffff;
	width: 20px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:horizontal:pressed {
	border: 1px solid grey;
	border-top-right-radius: 7px;
	border-top-left-radius: 7px;
	border-bottom-left-radius: 7px;
	background: #e7e7e7;
	width: 20px;
	subcontrol-position: left;
	subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover {
	border: 1px solid;
	border-color: #ff963c;
	border-bottom-right-radius: 7px;
	border-bottom-left-radius: 7px;
	border-top-left-radius: 7px;
	background: #ffffff;
	height: 20px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:pressed {
	border: 1px solid grey;
	border-bottom-left-radius: 7px;
	border-bottom-right-radius: 7px;
	border-top-left-radius: 7px;
	background: #e7e7e7;
	height: 20px;
	subcontrol-position: bottom;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:hover {
	border: 1px solid #ff963c;
	border-top-right-radius: 7px;
	border-top-left-radius: 7px;
	border-bottom-left-radius: 7px;
	background: #ffffff;
	height: 20px;
	subcontrol-position: top;
	subcontrol-origin: margin;
}

QScrollBar::sub-line:vertical:pressed {
	border: 1px solid grey;
	border-top-left-radius: 7px;
	border-top-right-radius: 7px;
	background: #e7e7e7;
	height: 20px;
	subcontrol-position: top;
	subcontrol-origin: margin;
}

QScrollBar::handle:vertical:hover {
	background: #fdfdfd;
	border: 1px solid #ff963c;
	border-radius: 7px;
	min-height: 25px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
	background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
	background: none;
}

QTabWidget {
	color:#000000;
	background-color:#f7f6f6;
}

QTabWidget::pane {
	border-color: #b4b4b4;
	background-color:#f7f6f6;
	border-style: solid;
	border-width: 1px;
	border-radius: 6px;
}

QTabBar::tab {
	padding-left:4px;
	padding-right:4px;
	padding-bottom:2px;
	padding-top:2px;
	color:#514841;
	background-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(221,218,217,255), stop:1 rgba(240,239,238,255));
	border-style: solid;
	border-width: 1px;
	border-top-right-radius:4px;
	border-top-left-radius:4px;
	border-top-color: #b4b4b4;
	border-left-color: #b4b4b4;
	border-right-color: #b4b4b4;
	border-bottom-color: transparent;
}

QTabBar::tab:!selected {
	margin-top: 1px;
	margin-right: 1px;
}

QTabBar::tab:hover,
QTabBar::tab:selected,
QTabBar::tab:last:selected {
	background-color:#f7f6f6;
	margin-left: 0px;
	margin-right: 1px;
}

QTextEdit {
	border-width: 1px;
	border-style: solid;
	border-color:transparent;
	color:#111111;
	selection-background-color:#ec7440;
}

QTimeEdit,
QToolBox,
QToolBox::tab,
QToolBox::tab:selected {
	color:#514841;
	background-color: #ffffff;
}
